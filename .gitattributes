# Normalise line endings so the repository is consistent across platforms.
* text=auto

# Shell / Python sources: LF
*.py   text eol=lf
*.sh   text eol=lf
*.toml text eol=lf
*.cff  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Binary and generated artefacts: never touch
*.pdf  binary
*.png  binary
*.h5   binary
*.json binary
*.csv  binary
